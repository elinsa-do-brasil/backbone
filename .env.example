# Database (PostgreSQL — Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL=postgresql://backbone:backbone@localhost:5432/backbone

# Local dev server (pnpm dev) bind — no effect on Vercel. Defaults to 0.0.0.0
# so devices on the same LAN (e.g. the Kotlin/Android app) can reach it via
# your machine's IP; set HOST=127.0.0.1 to restrict it to this machine only.
PORT=3000
HOST=0.0.0.0

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call /api/auth/* with credentials
# (e.g. your Next.js app's URL). Native clients (e.g. a Kotlin/Android app)
# don't send an Origin header, so this list doesn't affect them.
# Run your Next.js dev server on a different port than the one above (e.g. `next dev -p 3001`).
TRUSTED_ORIGINS=http://localhost:3001

# Root domain shared by the Next.js app (apex) and this backend (subdomain) in
# production, e.g. Next.js on example.com and this backend on auth.example.com
# -> COOKIE_DOMAIN=.example.com (leading dot). Makes the session cookie usable
# on both hosts. Leave empty in local development.
COOKIE_DOMAIN=

# Comma-separated list of extra WebAuthn origins allowed to complete passkey
# registration/sign-in, besides what the request itself provides. Needed for
# the Kotlin/Android app: its origin is `android:apk-key-hash:<base64url
# SHA-256 of the signing cert>`, not a URL. Leave empty in local development.
PASSKEY_ORIGINS=

# Comma-separated list of custom URI schemes (e.g. "filament://") native apps
# register as deep links, allowed as the `returnTo` target of
# /native-oauth-bridge (see src/index.ts) — the step that hands a native app
# a token after a browser-based OAuth flow (e.g. Microsoft) completes.
NATIVE_APP_SCHEMES=

# Microsoft OAuth (Entra ID) — https://portal.azure.com App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# GLPI (helpdesk.elinsadobrasil.com.br) — conta de serviço única usada por todas as chamadas
# do backend ao GLPI (o app nunca fala com o GLPI diretamente). Auth via OAuth2 (API v2):
# Configurar > Geral > API > criar um cliente OAuth2 pra obter CLIENT_ID/CLIENT_SECRET.
GLPI_URL_API="https://helpdesk.elinsadobrasil.com.br/api.php/v2.3"
GLPI_APP_CLIENT_ID=
GLPI_APP_CLIENT_SECRET=
# O grant client_credentials do GLPI só cobre o escopo "inventory" — acessar User/Ticket exige
# o grant "password", autenticando um usuário real. Usar as credenciais do usuário técnico de
# serviço aqui (não são as mesmas credenciais que um usuário do app usaria pra logar no GLPI).
GLPI_SERVICE_ACCOUNT_USERNAME=
GLPI_SERVICE_ACCOUNT_PASSWORD=
