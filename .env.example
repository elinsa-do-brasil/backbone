# Database (PostgreSQL — Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL=postgresql://backbone:backbone@localhost:5432/backbone

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call /api/auth/* with credentials.
# Native Expo requests don't send an Origin header, this is mainly for Expo web / browser testing.
TRUSTED_ORIGINS=http://localhost:8081

# Must match the "scheme" in your Expo app.json / app.config.ts
EXPO_SCHEME=myapp

# Microsoft OAuth (Entra ID) — https://portal.azure.com App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
